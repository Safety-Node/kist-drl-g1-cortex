// 냉장고에서 오이 가져오기 (KIST MBO 시연 1단계) — cortex TaskSrv 포맷.
//
// KAPEX: "G1, 냉장고에서 오이 하나 가져다주시겠어요?"
// G1   : ① 냉장고 이동 → ② 문 개방 → ③ 오이 파지 → ④ 조리대 tray 안착.
//
// 각 sub-task는 on_create에서 한국어 안내(speak label), on_start에서 실제 동작
// (navigation / vla label)을 발사하고, 성공은 VLM criterion(씬 판정)으로 본다.
// navigation / vla 목적지 payload는 placeholder — Gearsonic Handler 스펙 확정 후 채움.
//
// ⚠️ 지금은 어느 sub-task도 성공할 수 없다: vlm_node._evaluate가 백엔드 stub이라
//    항상 False를 반환한다(오판정 방지). 즉 전부 timeout → on_fail. 문법/배선 검증용.
//    실제로 도는 시나리오를 보려면 go_*.json5(delay) / greet.json5(always) 참고.
//
// TODO(REQ-XX): grasp_cucumber는 composite(joint_state AND vlm)이 맞다 — 그리퍼가
//   '뭔가를 물었다'(기하)와 '그게 오이다'(의미)는 서로 다른 실패 모드를 잡는다.
//   joint_state가 perception 노드로 들어오면 교체할 것. 반대로 approach_fridge의
//   도착 판정은 uwb_pose 단독이 맞다(AND는 실패 모드만 추가).
{
  name: "refrigerator_pickup",
  triggers: ["냉장고에서 오이", "오이 가져와", "오이 하나 가져다", "오이 부탁"],
  sub_tasks: [
    {
      // nav에도 precondition 사용 가능: grounding 왕복이 없으므로 vlm이 전용
      // 판정(PreconditionReport)을 하고, orchestrator는 on_start를 최대
      // precondition_timeout_s(3s)까지 유예한다 (안 오면 fail-open으로 출발).
      name: "approach_fridge",
      precondition: "the path ahead of the robot is clear",
      on_create: [{ speak: "냉장고 앞으로 갑니다." }],
      on_start:  [{ navigation: "goal:refrigerator" }],
      success:   { type: "vlm", check: "robot is facing the refrigerator door", timeout_s: 25 },
      on_fail:   [{ speak: "냉장고로 이동하지 못했습니다." }],
    },
    {
      // vla 페이로드가 dict({grounded, goal})이면 이 문자열이 그대로 VLA로 가지 않는다:
      // goal이 Subtask.goal_text로 vlm_node에 전달되고, vlm이 현재 프레임을 보고
      // 장면 특화 명령문(VlaPrompt)으로 바꿔주면 그때 vla connector가 발사된다.
      // success.progress_gate: VLA task_progress가 이 값 이상일 때만 vlm이 판정한다
      // (동작 중간 장면을 실패로 오판하지 않도록). timeout은 grounding+동작을 합쳐 센다.
      name: "open_door",
      on_create: [{ speak: "냉장고 문을 엽니다." }],
      on_start:  [{ vla: { grounded: true, goal: "open the refrigerator door" } }],
      success:   { type: "vlm", check: "refrigerator door is open", timeout_s: 20,
                   progress_gate: 0.9 },
      on_fail:   [{ speak: "냉장고 문을 열지 못했습니다." }],
    },
    {
      // precondition: grounded vla 발사 전에 성립해야 하는 장면 조건.
      // grounding과 같은 VLM 호출에서 판정되어 VlaPrompt에 실려 돌아온다.
      // 기본은 shadow(경고 로그만) — precondition_enforce: true 여야 실제로 막는다.
      name: "grasp_cucumber",
      precondition: "the refrigerator door is open and a cucumber is visible",
      on_create: [{ speak: "오이를 집겠습니다." }],
      on_start:  [{ vla: { grounded: true, goal: "pick up the cucumber from the shelf" } }],
      success:   { type: "vlm", check: "a cucumber is held in the right gripper", timeout_s: 20,
                   progress_gate: 0.9 },
      on_fail:   [{ speak: "오이를 집지 못했습니다." }],
    },
    {
      name: "place_on_tray",
      on_create: [{ speak: "조리대에 오이를 놓습니다." }],
      on_start:  [
        { navigation: "goal:counter" },
        { vla: "Place the cucumber on the tray." },
      ],
      success:     { type: "vlm", check: "the cucumber is resting on the tray", timeout_s: 20 },
      on_success:  [{ speak: "오이 가져왔습니다." }],
      on_fail:     [{ speak: "오이를 tray에 놓지 못했습니다." }],
    },
  ],
}
